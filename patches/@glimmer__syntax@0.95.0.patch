+// Patched (emberjs/ember.js acd8261c6b, unreleased in @glimmer/syntax 0.95.0):
+// cache line starts so position conversion is O(log n) instead of a rescan per call.
+function patchSource(Source) {
+  Source.prototype.lineStarts = function () {
+    if (!this._lineStarts) {
+      const starts = [0];
+      for (let i = this.source.indexOf("\n"); i !== -1; i = this.source.indexOf("\n", i + 1)) starts.push(i + 1);
+      this._lineStarts = starts;
+    }
+    return this._lineStarts;
+  };
+  Source.prototype.hbsPosFor = function (offset) {
+    if (offset > this.source.length) return null;
+    const starts = this.lineStarts();
+    let lo = 0, hi = starts.length - 1;
+    while (lo < hi) {
+      const mid = (lo + hi + 1) >> 1;
+      if (starts[mid] <= offset) lo = mid; else hi = mid - 1;
+    }
+    return { line: lo + 1, column: offset - starts[lo] };
+  };
+  Source.prototype.charPosFor = function (position) {
+    const starts = this.lineStarts(), sourceLength = this.source.length, line = position.line, column = position.column;
+    if (line - 1 >= starts.length) return sourceLength;
+    const lineStart = starts[line - 1], lineEnd = line < starts.length ? starts[line] - 1 : sourceLength;
+    return lineStart + column > lineEnd ? lineEnd : lineStart + column;
+  };
+}
+const original = require('./index.cjs');
+patchSource(original.src.Source);
+module.exports = original;
